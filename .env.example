# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser enviado ao Git (já está no .gitignore).

# --- Segurança / JWT ---
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Banco de dados de usuários (SQLite por padrão, arquivo local) ---
DATABASE_URL=sqlite:///./data/usuarios.db

# --- Arquivo de dados (planilha) ---
# Por enquanto, um arquivo local. Na próxima etapa isso vira a sincronização com o OneDrive.
CAMINHO_PLANILHA_TAREFAS=./data/tarefas.xlsx
CAMINHO_PLANILHA_PROCESSOS_PARADOS=./data/processos_parados.xlsx
CAMINHO_PLANILHA_PROCESSOS=./data/processos.xlsx

# --- CORS (endereços autorizados a consumir a API) ---
# Em produção, coloque o domínio real do dashboard (ex: https://seudominio.com.br)
ORIGENS_PERMITIDAS=http://localhost:3000,http://localhost:8080

# --- Apenas para testes locais com planilhas antigas (deixe em branco em produção) ---
# Formato DD/MM/AAAA. Faz a API calcular os prazos como se "hoje" fosse essa data.
DATA_REFERENCIA_TESTE=
